{
  "schema_version": 1,
  "root_files": [
    ".dockerignore",
    ".gitignore",
    "AGENTS.md",
    "Cargo.toml",
    "Directory.Build.props",
    "Directory.Packages.props",
    "Dockerfile",
    "Gemfile",
    "Makefile",
    "README.md",
    "build.gradle",
    "build.gradle.kts",
    "compose.yaml",
    "compose.yml",
    "composer.json",
    "docker-compose.yaml",
    "docker-compose.yml",
    "global.json",
    "go.mod",
    "package.json",
    "pnpm-workspace.yaml",
    "pom.xml",
    "pyproject.toml",
    "requirements.txt"
  ],
  "code_extensions": [
    ".cjs",
    ".config",
    ".cs",
    ".csproj",
    ".css",
    ".fsproj",
    ".go",
    ".html",
    ".java",
    ".js",
    ".json",
    ".jsx",
    ".kt",
    ".md",
    ".mjs",
    ".php",
    ".props",
    ".ps1",
    ".py",
    ".rb",
    ".rs",
    ".scss",
    ".sh",
    ".sln",
    ".slnx",
    ".sql",
    ".svelte",
    ".swift",
    ".targets",
    ".tf",
    ".toml",
    ".ts",
    ".tsx",
    ".vue",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "excluded_directories": [
    ".angular",
    ".cache",
    ".git",
    ".gradle",
    ".idea",
    ".next",
    ".nuxt",
    ".turbo",
    ".venv",
    ".vs",
    "__pycache__",
    "bin",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "obj",
    "playwright-report",
    "test-results",
    "vendor",
    "venv"
  ],
  "excluded_suffixes": [
    ".bak",
    ".cer",
    ".crt",
    ".db",
    ".docx",
    ".dump",
    ".key",
    ".lockb",
    ".p12",
    ".pdf",
    ".pem",
    ".pfx",
    ".sqlite",
    ".sqlite3",
    ".xlsx",
    ".zip"
  ],
  "metadata_only_files": [
    ".npmrc",
    ".pypirc",
    "appsettings.development.json",
    "appsettings.json",
    "appsettings.production.json",
    "appsettings.staging.json",
    "credentials.json",
    "nuget.config",
    "secrets.json",
    "web.config"
  ],
  "source_roots": [
    ".source",
    "api",
    "app",
    "backend",
    "client",
    "cmd",
    "core",
    "frontend",
    "internal",
    "lib",
    "libs",
    "packages",
    "pkg",
    "server",
    "services",
    "specs",
    "src",
    "test",
    "tests",
    "web"
  ],
  "extra_scan_roots": [
    ".agents/.documents",
    ".github/workflows"
  ],
  "limits": {
    "file_cap": 12000,
    "max_hash_bytes": 2097152,
    "index_paths": 10,
    "change_paths": 35
  },
  "paths": {
    "state_dir": ".agents/state",
    "manifest": ".agents/state/infrastructure.json",
    "index": ".agents/state/infrastructure-index.md",
    "changelog_dir": ".handoffs/.details"
  }
}
